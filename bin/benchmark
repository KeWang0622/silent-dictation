#!/usr/bin/env bash
# bin/benchmark /path/to/vidtimit [--llm] [--model flare|auto_avsr] [--beam N]   (see benchmarks/README.md)
DIR="$(cd "$(dirname "$(readlink -f "$0")")/.." && pwd)"
if [[ ! -x "$DIR/.venv/bin/python" ]]; then
  echo "Run $DIR/setup.sh first." >&2
  exit 1
fi
export PYTHONPATH="$DIR${PYTHONPATH:+:$PYTHONPATH}"
exec "$DIR/.venv/bin/python" "$DIR/benchmarks/vidtimit.py" "$@"
